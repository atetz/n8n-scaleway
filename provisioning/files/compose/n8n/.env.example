# Copy to .env and fill in. Never commit .env.

DOMAIN=n8n.example.com
GENERIC_TIMEZONE=Europe/Amsterdam

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# Use the existing key: docker exec n8n cat /home/node/.n8n/config  (field "encryptionKey")
N8N_ENCRYPTION_KEY=

# Only used if the restricted router is enabled, e.g. 203.0.113.10/32,198.51.100.0/24
IP_WHITELIST=
